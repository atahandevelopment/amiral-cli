{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/opencode-ai-team/execution-request.schema.json",
  "title": "OpenCode AI Team Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "task_id",
    "agent",
    "title",
    "description",
    "acceptance_criteria",
    "lease_id",
    "attempt",
    "max_attempts",
    "created_at",
    "context"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "enum": [
        "planner",
        "uiux-designer",
        "frontend",
        "backend",
        "database",
        "devops",
        "reviewer",
        "qa"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_type",
        "dependencies",
        "result_path"
      ],
      "properties": {
        "workflow_type": {
          "type": "string",
          "enum": [
            "feature",
            "bugfix",
            "refactor"
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
