{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amiral/review-fix-plan.schema.json",
  "title": "Amiral Review Fix Plan",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "agent",
      "description",
      "dependencies",
      "acceptance_criteria",
      "source_finding_indexes"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^FIX-R[0-9]+-[0-9]{3}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "agent": {
        "type": "string",
        "enum": [
          "frontend",
          "backend",
          "database",
          "devops",
          "reviewer",
          "qa",
          "planner"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "acceptance_criteria": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source_finding_indexes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
