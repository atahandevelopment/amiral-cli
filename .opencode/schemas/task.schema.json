{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode AI Team Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "agent", "description", "dependencies", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "enum": ["planner", "frontend", "backend", "database", "devops", "reviewer", "qa"]},
    "description": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "parallel": {"type": "boolean"},
    "estimated_complexity": {"type": "string", "enum": ["trivial", "low", "medium", "high", "critical"]},
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
