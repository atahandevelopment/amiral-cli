{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/opencode-ai-team/workflow-state.schema.json",
  "title": "OpenCode AI Team Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "workflow_type",
    "status",
    "created_at",
    "updated_at",
    "tasks",
    "max_attempts",
    "lease_id",
    "lease_expires_at"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_type": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor"]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "blocked",
        "failed",
        "completed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "agent",
          "description",
          "dependencies",
          "acceptance_criteria",
          "status",
          "attempts"
        ],
        "properties": {
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "lease_id": {
            "type": ["string", "null"]
          },
          "lease_expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "enum": [
              "planner",
              "frontend",
              "backend",
              "database",
              "devops",
              "reviewer",
              "qa"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_error": {
            "type": ["string", "null"]
          },
          "result_file": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
