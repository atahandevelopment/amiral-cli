{
  "name": "amiral-ai",
  "version": "0.1.4",
  "description": "Dependency-aware multi-agent workflow CLI for OpenCode.",
  "bin": {
    "amiral": "dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "README_TR.md",
    "assets/amiral-ai.png",
    "vendor",
    "memory"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean:dist && npm run build",
    "validate:team": "tsx scripts/validate-team.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "directories": {
    "example": "examples"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "fast-deep-equal": "^3.1.3",
    "fast-uri": "^3.1.5",
    "json-schema-traverse": "^1.0.0",
    "proper-lockfile": "^4.1.2",
    "require-from-string": "^2.0.2",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atahandevelopment/opencode-ai-team.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/atahandevelopment/opencode-ai-team/issues"
  },
  "homepage": "https://github.com/atahandevelopment/opencode-ai-team#readme"
}
