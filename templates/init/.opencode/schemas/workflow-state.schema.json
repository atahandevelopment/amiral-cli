{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/opencode-ai-team/workflow-state.schema.json",
  "title": "OpenCode AI Team Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "workflow_type",
    "status",
    "created_at",
    "updated_at",
    "tasks",
    "max_attempts",
    "lease_id",
    "lease_expires_at"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_type": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor"]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "blocked",
        "failed",
        "completed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "agent",
          "description",
          "dependencies",
          "acceptance_criteria",
          "status",
          "attempts"
        ],
        "properties": {
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "lease_id": {
            "type": ["string", "null"]
          },
          "lease_expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "enum": [
              "planner",
              "frontend",
              "backend",
              "database",
              "devops",
              "reviewer",
              "qa"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "retry_wait",
              "completed",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "retry_not_before": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_provider_error": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "provider",
              "kind",
              "message",
              "retryable"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "status_code": {
                "type": "integer"
              }
            }
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_error": {
            "type": ["string", "null"]
          },
          "result_file": {
            "type": ["string", "null"]
          },
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "fixed",
                  "auto"
                ]
              },
              "required_capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "preferred_agents": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "planner",
                    "frontend",
                    "backend",
                    "database",
                    "devops",
                    "reviewer",
                    "qa"
                  ]
                }
              }
            }
          },
          "planning": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "critical"
                ]
              },
              "estimated_complexity": {
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large"
                ]
              },
              "risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "expected_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "conflict_domains": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "parallel_group": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
